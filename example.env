# One key per Tavily account, comma separated. Queries are handed out
# round-robin so no single account absorbs the whole batch, and a key the
# API refuses is dropped from the rotation mid-run. A lone key still works.
TAVILY_API_KEYS=
# 1 = probe every key once before the first real search (one search each).
TAVILY_KEY_HEALTHCHECK=1
# Seconds a rate-limited (429) key sits out; 3 benchings in a row retire it.
TAVILY_KEY_COOLDOWN_S=60
LANGSMITH_API_KEY=

WORKFLOW_REPO=
VLLM_BASELINE_REPO=
VLLM_CONTINUUM_REPO=
VLLM_OURS_REPO=

WORKFLOW_VENV=
VLLM_BASELINE_VENV=
VLLM_CONTINUUM_VENV=
VLLM_OURS_VENV=
LMCACHE_VENV=

BENCH_ROOT=
TRACE_DIR=
REPORT_DIR=
LMCACHE_L2_DIR=
VLLM_LOG_DIR=
TAVILY_CACHE_DIR=

ODR_TRACE_PATH=

MODEL_NAME=Qwen/Qwen2.5-72B-Instruct-AWQ
MODEL_PROVIDER=openai
MODEL_TEMPERATURE=0.0
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=EMPTY

SUMMARIZATION_MODEL_MAX_TOKENS=8192
RESEARCH_MODEL_MAX_TOKENS=10000
COMPRESSION_MODEL_MAX_TOKENS=10000
FINAL_REPORT_MODEL_MAX_TOKENS=10000

DISABLE_THINK_TOOL=true
LANGGRAPH_PROMPT_PSEUDO_DYNAMIC=0
# 1 = full node-aware eviction policy, 0 = upstream LRU, empty = the arm
# decides. Applies only to arms that declare VLLM_NODE_EVICTION_POLICY in
# arms.toml (i.e. `ours`); baseline and continuum are the control and are
# never switched by it.
BENCH_NODE_EVICTION=
# 1 = agent prefix prefetch on, 0 = off, empty = the arm decides. `ours` only,
# for the same reason as above.
BENCH_PREFETCH=
# 1 = seed the AgentPrefixRegistry with each node's system prompt before the
# measured phase, 0 = skip it, empty = the arm decides. `ours` only.
BENCH_SEED_PREFIXES=
# 1 = rebuild compress_research's and final_report_generation's prompts from
# requests already sent and prefill them early, 0 = off, empty = the arm
# decides. `ours` only. Speculative prefill -- report it as its own arm.
BENCH_PROMPT_SEEDS=
# --- two stacks on one box (see plan/runbooks/04-parallel.md) ---
# Defaults are for a single stack; a second concurrent one overrides these
# four in plan/runbooks/stack-b.env, not here. BENCH_GPU is below, with the
# other preflight knobs.
BENCH_PORT=8000
BENCH_LMCACHE_PORT=10903
# Suffixes this stack's tmux sessions (vllm-b, lmcache-b). Defaults to the
# port, so two stacks can never silently share a session name.
BENCH_INSTANCE=default

TAVILY_CACHE_ENABLE=1
# 1 = on a cache hit, still send the query and discard the live response, so
# the query spans time a real search. Same results reach the agent either way.
TAVILY_CACHE_PINNED=0
# Summarization fallback -> trace miss under pinned replay; keep the first
# below the second, which is the outer limit on the same call.
SUMMARIZATION_TIMEOUT_S=600
ODR_HTTP_TIMEOUT_S=900
ODR_FROZEN_DATE=
ODR_TOOL_MARKERS=1

BENCH_GPU=0
# Host RAM, per stack -- two concurrent stacks each allocate their own, so
# halve it when running two (plan/runbooks/stack-*.env ship 100).
BENCH_LMCACHE_L1_GB=200
BENCH_RAM_MARGIN_GB=60
BENCH_MIN_FREE_RAM_GB=
BENCH_SERVER_READY_TIMEOUT_S=1800
BENCH_PREFETCH_LEAD_MIN_S=0.1
BENCH_ABORT_FREE_RAM_GB=32
BENCH_ABORT_VRAM_FRAC=0
BENCH_RESOURCE_INTERVAL_S=5
KV_FORECAST_REDIS_URL=redis://127.0.0.1:6379/0

LANGSMITH_TRACING=true
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

LANGGRAPH_VLLM_ECHO_BASE_URL=http://localhost:8000
