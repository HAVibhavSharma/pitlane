# Sourced by every runbook: `set -a; . common.env; set +a`
# Secrets are NOT here. Keep them in ~/.bench.env and source that first:
#   TAVILY_API_KEYS (or TAVILY_API_KEY), LANGSMITH_API_KEY
#
# TAVILY_API_KEYS holds one key per account, comma separated. A 50-question
# batch issues thousands of searches and will exhaust a single account's
# credits part-way through; the workflow hands each query to the next key in
# turn so the spend divides evenly, and drops any key the API refuses. Probe
# them before a long run:
#   python tests/check_tavily_keys.py   # in $WORKFLOW_REPO
: "${TAVILY_API_KEYS:=${TAVILY_API_KEY:?set TAVILY_API_KEYS or TAVILY_API_KEY in ~/.bench.env}}"
export TAVILY_API_KEYS
# Probe every key once at the first search, so a dead account is named at
# startup rather than three hours into a batch.
export TAVILY_KEY_HEALTHCHECK=1
# A 429 benches a key for this long; three benchings in a row retire it.
export TAVILY_KEY_COOLDOWN_S=60

# --- paths (edit to match the box) ---
export WORKFLOW_REPO=/home/vibhav/open_deep_research
export VLLM_BASELINE_REPO=/home/vibhav/Build/vllm-baseline
export VLLM_CONTINUUM_REPO=/home/vibhav/Build/vllm-continuum
export VLLM_OURS_REPO=/home/vibhav/Build/KVCOMM-VLLM/vllm

# --- one virtualenv per build ---
# Three vllm checkouts cannot share one site-packages. Unset these and
# `vllm serve` resolves on PATH, so every arm boots whichever build the shell
# activated -- the run completes and compares a stack against itself.
# Defaults only: copy example.env at the repo root to .env, fill it in, and
# source it before this file to override them without editing a tracked file.
export VLLM_BASELINE_VENV=/home/vibhav/venvs/baseline
export VLLM_CONTINUUM_VENV=/home/vibhav/venvs/continuum
export VLLM_OURS_VENV=/home/vibhav/venvs/ours
export WORKFLOW_VENV=/home/vibhav/venvs/odr
export TRACE_DIR=/disk2/vibhav/traces
export REPORT_DIR=/disk2/vibhav/reports
export LMCACHE_L2_DIR=/disk2/vibhav/lmcache
export VLLM_LOG_DIR=/disk2/vibhav/vllm-logs

# --- model / client ---
export MODEL_PROVIDER=openai
export MODEL_NAME=Qwen/Qwen2.5-72B-Instruct-AWQ
export MODEL_TEMPERATURE=0.0
export OPENAI_BASE_URL=http://localhost:8000/v1
export OPENAI_API_KEY=EMPTY
export DISABLE_THINK_TOOL=true

# --- workflow knobs (identical across arms; changing one invalidates the trace) ---
export LANGGRAPH_PROMPT_PSEUDO_DYNAMIC=0
export SUMMARIZATION_MODEL_MAX_TOKENS=8192
export RESEARCH_MODEL_MAX_TOKENS=10000
export COMPRESSION_MODEL_MAX_TOKENS=10000
export FINAL_REPORT_MODEL_MAX_TOKENS=10000
export TAVILY_CACHE_ENABLE=1
export TAVILY_CACHE_DIR=/disk2/vibhav/tavily_cache
# On a cache hit the query still goes out to Tavily and the live response is
# discarded in favour of the cached one, so `tavily_search.query` spans time a
# real search instead of a disk read. Trajectory-safe: the agent is handed the
# same frozen results either way, so the trace stays valid -- only wall-clock
# moves. Set it for every arm or none; one arm alone carries seconds of tool
# time the others don't. Costs a live API call per query, so rate limits apply.
export TAVILY_CACHE_PINNED=1
# A summarization that overruns falls back to the raw page, which is ~10x
# longer than its summary -- under pinned replay the next prompt then matches
# nothing in the trace and the question dies on a trace miss. It fires where
# the server is slowest, so it is biased toward whichever arm is losing: it
# cost continuum question 35 of the n50 batch. The first must stay BELOW the
# second, which is the outer limit on the same call.
export SUMMARIZATION_TIMEOUT_S=600
export ODR_HTTP_TIMEOUT_S=900
export ODR_FROZEN_DATE=2026-08-04

# --- tracing (optional) ---
export LANGSMITH_TRACING=true
export LANGSMITH_PROJECT=MTP
export LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- the trace under test: same file for every eval arm ---
export ODR_TRACE_PATH=$TRACE_DIR/drb_v1_3.jsonl
