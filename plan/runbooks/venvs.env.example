# Per-build virtualenvs. Copy to `venvs.env`, fill in the four paths, and
# source it *before* common.env:
#
#   set -a; . ~/.bench.env; . venvs.env; . common.env; set +a
#
# `venvs.env` is gitignored, so the paths below never travel with the repo.
#
# common.env carries defaults for these keys, and a real environment variable
# wins over the file, so whatever you set here is what pitlane uses. Keeping
# them in their own file means the box-specific paths are the only thing you
# edit when moving to another machine, and `venvs.env` can stay untracked.
#
# Point each at the **venv root**, not at a binary: pitlane appends `bin/vllm`
# and `bin/python` itself.
#
# Why one per build, and why it matters more than it looks: three checkouts of
# vllm cannot share one site-packages. With these unset, `vllm serve` resolves
# on PATH and every arm boots whichever build the shell happened to activate.
# The run completes, the numbers look plausible, and the comparison is a stack
# against itself. Nothing in the output says so, which is why `pitlane
# preflight` warns when one is missing.

# --- one virtualenv per vLLM build -------------------------------------
# Each must pair with the matching *_REPO in common.env.
export VLLM_BASELINE_VENV=                 # pairs with VLLM_BASELINE_REPO
export VLLM_CONTINUUM_VENV=                # pairs with VLLM_CONTINUUM_REPO
export VLLM_OURS_VENV=                     # pairs with VLLM_OURS_REPO

# --- the workflow's own environment ------------------------------------
# open_deep_research / swe-agent and the langgraph fork they import. Separate
# from the server venvs: the workflow talks to vLLM over HTTP and shares no
# packages with it.
export WORKFLOW_VENV=                      # pairs with WORKFLOW_REPO

# --- creating them ------------------------------------------------------
# One venv per repo, then install that repo into it the way you normally build
# it (an editable install for the workflow, your usual compile for vLLM). The
# point is only that the interpreter differs per arm:
#
#   python -m venv "$VLLM_OURS_VENV"
#   . "$VLLM_OURS_VENV/bin/activate"
#   cd "$VLLM_OURS_REPO" && <your build/install step>
#   deactivate
#
# The workflow venv must also carry the langgraph fork, not the released
# package -- ODR imports `langgraph.pregel._vllm_agent`, which only exists
# there, and a venv resolving the published langgraph fails at import.

# --- verifying ----------------------------------------------------------
# Both binaries must exist before a run. This prints one line per environment:
#
#   for v in VLLM_BASELINE_VENV VLLM_CONTINUUM_VENV VLLM_OURS_VENV; do
#     printf '%-22s %s\n' "$v" \
#       "$([ -x "$(eval echo \$$v)/bin/vllm" ] && echo ok || echo MISSING)"
#   done
#   printf '%-22s %s\n' WORKFLOW_VENV \
#     "$([ -x "$WORKFLOW_VENV/bin/python" ] && echo ok || echo MISSING)"
#
# Or let the tool do it, which also checks the repos, GPU, RAM and ports:
#
#   pitlane preflight --arm ours
#
# and read the `venv [...]` lines. A warning there means the fallback to PATH
# is live, which is the failure that produces believable wrong numbers.
