# Stack B: the second of two concurrent stacks on a two-GPU box.
#
# Layered over the usual chain with `--env-extra`, so it only holds what makes
# this stack different from the other one:
#
#   pitlane run --env-extra plan/runbooks/stack-b.env ...
#
# Its tmux sessions are `vllm-b` and `lmcache-b` and its redis database is 1, so
# nothing it starts -- or kills on the way down -- can reach into stack A.
export BENCH_GPU=1
export BENCH_PORT=8001
export BENCH_LMCACHE_PORT=10904
export BENCH_INSTANCE=b
export KV_FORECAST_REDIS_URL=redis://127.0.0.1:6379/1

# The one number that must be halved rather than copied: LMCache's L1 pool is
# CPU memory and each stack allocates its own.
#
# 100 is not a squeeze. The n50 batch consumed 4.6 GB (baseline), 5.3 GB
# (continuum) and 17.9 GB (ours) above the 20 GB initial pool -- so ~25 to
# ~38 GB of actual peak against a 200 GB ceiling that was never approached.
# Keep A and B EQUAL, and do not go far below this: while no arm reaches its
# ceiling, L1 size changes nothing measurable, but the moment one does, LRU
# starts firing and the ceiling becomes an experimental variable -- and `ours`,
# the arm with the eviction policy under test, is the one that caches most.
export BENCH_LMCACHE_L1_GB=100
